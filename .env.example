# ---- Required ----
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# ElevenLabs voice IDs for the kid and adult profiles (multilingual voices work for both languages)
ELEVENLABS_VOICE_KID=
ELEVENLABS_VOICE_ADULT=

# ---- Optional ----
# Separate voices for English lessons. If empty, the voices above are used.
# ELEVENLABS_VOICE_KID_EN=
# ELEVENLABS_VOICE_ADULT_EN=

PORT=8787
# HOST=127.0.0.1           # use 0.0.0.0 to open to other devices (then FAMILY_PIN is required)

# Family PIN (6 digits). Leave empty only when the server runs on this computer alone.
# The server refuses to start without it if ALLOWED_HOSTS, TRUST_PROXY=1, or a non-loopback HOST is set.
FAMILY_PIN=
# Cookie signing secret (32+ random characters). Set it so devices stay remembered across restarts.
# PIN_SECRET=

# Behind a tunnel on this computer (ngrok, tailscale serve): trust its X-Forwarded-For / X-Forwarded-Proto.
# Do not enable when the server is exposed directly.
# TRUST_PROXY=1
# Extra host names allowed (comma-separated). IP addresses, localhost and *.ts.net are always allowed.
# ALLOWED_HOSTS=mypc.lan

# Log question text in server logs (default on). Set 0 to log only character counts.
# LOG_TEXT=0

# Models and thinking levels (empty = defaults). Thinking: minimal|low|medium|high|xhigh (varies by model)
# QUICK_MODEL=gemini-3.8-flash
# QUICK_THINKING=low
# DEEP_MODEL=gemini-4-neon
# DEEP_THINKING=high
# ARTIST_MODEL=gemini-3.8-flash
# CLASSIFY_MODEL=gemini-3.5-flash-lite

# Dev server / e2e port
# PW_PORT=5173
